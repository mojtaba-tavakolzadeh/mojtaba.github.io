+/* ------------------------------------------------------------------
+   Persian modern portfolio refresh — hero, projects and motion system
+   ------------------------------------------------------------------ */
+:root {
+  --iran-gold: #d9a441;
+  --iran-gold-light: #f4d58a;
+  --iran-ink: #101b2b;
