+
+/* ==========================================================================
+   PERSIAN HERITAGE REDESIGN — Persepolis-inspired visual system
+   This override intentionally lives in the existing custom.css file.
+   ========================================================================== */
+
+:root {
+  --persian-night: #101b1b;
+  --persian-ink: #172624;
+  --persian-stone: #e8dfca;
+  --persian-paper: #f5f0e4;
+  --persian-gold: #c6a15b;
+  --persian-gold-light: #e4c985;
+  --persian-turquoise: #397f78;
+  --persian-muted: #a9b2a8;
+  --persian-line: rgba(198, 161, 91, .32);
+}
+
+html { scroll-behavior: smooth; scroll-padding-top: 82px; }
+body {
+  background: var(--persian-paper);
+  color: #3d4944;
+  font-family: "Segoe UI", Tahoma, Arial, sans-serif;
+  font-size: 15px;
+  line-height: 1.8;
+}
+h1, h2, h3, h4, h5, h6 {
+  color: var(--persian-ink);
+  font-family: Georgia, "Times New Roman", serif;
+  letter-spacing: .015em;
+}
+a { color: var(--persian-turquoise); }
+a:hover { color: #a47c37; }
+::selection { background: var(--persian-gold); color: #111b19; }
+
+/* Navigation: a dark bronze inscription band */
+#mainNav {
+  padding: 15px 0;
+  background: rgba(15, 27, 26, .94);
+  border-bottom: 1px solid rgba(198, 161, 91, .45);
+  box-shadow: 0 8px 30px rgba(0,0,0,.16);
+  transition: all .25s ease;
+}
+#mainNav .navbar-brand {
+  color: var(--persian-gold-light);
+  font-family: Georgia, serif;
+  font-size: 1.12rem;
+  letter-spacing: .06em;
+}
+#mainNav .nav-link {
+  color: #e8e2d4;
+  font-size: .78rem;
+  font-weight: 700;
+  letter-spacing: .12em;
+  text-transform: uppercase;
+  padding: .65rem .8rem;
+}
+#mainNav .nav-link:hover,
+#mainNav .nav-link.active { color: var(--persian-gold-light); }
+#mainNav .nav-link:after {
+  content: "";
+  display: block;
+  height: 1px;
+  width: 0;
+  margin: 5px auto 0;
+  background: var(--persian-gold);
+  transition: width .25s ease;
+}
+#mainNav .nav-link:hover:after,
+#mainNav .nav-link.active:after { width: 75%; }
+.navbar-toggler { border: 1px solid var(--persian-gold); padding: 7px 9px; }
+.navbar-toggler span { background: var(--persian-gold-light); }
+
+/* The entrance to the palace: retain the existing portrait asset. */
+.intro {
+  min-height: 760px;
+  height: 100vh;
+  max-height: 980px;
+  background-position: center 27%;
+  background-attachment: scroll;
+  position: relative;
+  overflow: hidden;
+  border-bottom: 5px solid var(--persian-gold);
+}
+.intro:before,
+.intro:after {
+  content: "";
+  position: absolute;
+  z-index: 2;
+  pointer-events: none;
+}
+.intro:before {
+  inset: 22px;
+  border: 1px solid rgba(228,201,133,.62);
+  outline: 1px solid rgba(228,201,133,.22);
+  outline-offset: 8px;
+}
+.intro:after {
+  left: 50%;
+  bottom: 34px;
+  width: 110px;
+  height: 28px;
+  transform: translateX(-50%);
+  border-top: 1px solid var(--persian-gold-light);
+  border-bottom: 1px solid var(--persian-gold-light);
+  opacity: .85;
+}
+.overlay-itro {
+  background:
+    linear-gradient(90deg, rgba(9,20,19,.94) 0%, rgba(12,24,22,.76) 42%, rgba(12,24,22,.18) 100%),
+    linear-gradient(0deg, rgba(9,20,19,.68), transparent 55%);
+  opacity: 1;
+}
+.intro-content { position: relative; z-index: 3; text-align: left; }
+.intro-content .container { max-width: 1180px; padding-left: 8%; }
+.intro-content .container:before {
+  content: "WELCOME TO MY WORLD";
+  display: block;
+  color: var(--persian-gold-light);
+  font-size: .78rem;
+  font-weight: 700;
+  letter-spacing: .34em;
+  margin-bottom: 22px;
+}
+.intro-content .container:after {
+  content: "MOJTABA TAVAKOLZADEH\A Senior DevOps & Platform Engineer\A Building reliable platforms, inspired by enduring foundations.";
+  white-space: pre-line;
+  display: block;
+  max-width: 720px;
+  color: #f5f0e4;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(2rem, 5vw, 4.5rem);
+  font-weight: 600;
+  line-height: 1.2;
+  text-shadow: 0 4px 25px rgba(0,0,0,.35);
+}
+.intro-content .container:after { }
+.intro-content .container {
+  border-left: 2px solid var(--persian-gold);
+  padding-top: 18px;
+  padding-bottom: 18px;
+}
+.intro-content .container:before { padding-left: 2px; }
+.intro-content .container:after { padding-left: 2px; }
+
+/* Shared section rhythm and headings */
+section { padding-top: 92px !important; padding-bottom: 78px !important; }
+.title-box { margin-bottom: 3.2rem; }
+.title-a {
+  color: var(--persian-ink);
+  font-family: Georgia, serif;
+  font-size: clamp(2rem, 3.5vw, 2.8rem);
+  font-weight: 700;
+  letter-spacing: .04em;
+  text-transform: none;
+}
+.subtitle-a { color: #69736a; font-size: 1rem; }
+.line-mf {
+  width: 76px;
+  height: 3px;
+  margin-top: 20px;
+  background: linear-gradient(90deg, var(--persian-gold), var(--persian-turquoise));
+}
+.title-box-2 { margin-bottom: 2rem; }
+.title-left { font-size: 1.75rem; }
+.title-left:before { height: 2px; width: 66px; background: var(--persian-gold); }
+
+/* About panel */
+.about-mf { background: var(--persian-paper); }
+.box-shadow-full {
+  padding: clamp(1.5rem, 4vw, 3.4rem);
+  background: #fffdf7;
+  border: 1px solid #e1d5bc;
+  border-top: 4px solid var(--persian-gold);
+  border-radius: 3px;
+  box-shadow: 0 18px 55px rgba(30,42,35,.09);
+}
+.about-img img {
+  border-radius: 2px !important;
+  border: 7px solid #f1e8d5;
+  box-shadow: 0 8px 25px rgba(25,35,29,.14);
+}
+.title-s { color: #9a7639; font-size: .95rem; }
+.about-info p { padding-bottom: 8px; border-bottom: 1px solid #eee7d9; }
+.about-me p { color: #59645d; }
+
+/* Experience cards */
+.portfolio-mf { background: #eee8da; }
+.work-box {
+  overflow: hidden;
+  background: #fffdf7;
+  border: 1px solid #ded2b8;
+  border-radius: 3px;
+  box-shadow: 0 10px 28px rgba(32,43,35,.07);
+  transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
+}
+.work-box:hover {
+  transform: translateY(-7px);
+  border-color: var(--persian-gold);
+  box-shadow: 0 18px 38px rgba(32,43,35,.14);
+}
+.work-img { overflow: hidden; background: #e8e0ce; }
+.work-img img { transition: transform .55s ease; }
+.work-box:hover .work-img img { transform: scale(1.045); }
+.work-content { padding: 1rem 1.25rem 1.35rem; }
+.w-title { color: var(--persian-ink); font-size: 1.2rem; }
+.w-more { color: #778078; }
+.w-ctegory { color: #9b783e; }
+.work-btn .btn,
+.btn-primary {
+  color: #172522;
+  background: var(--persian-gold-light);
+  border: 1px solid #b18b49;
+  border-radius: 2px;
+  font-weight: 700;
+  letter-spacing: .03em;
+  padding: .55rem 1.15rem;
+}
+.work-btn .btn:hover,
+.btn-primary:hover {
+  color: #fffaf0;
+  background: var(--persian-turquoise);
+  border-color: var(--persian-turquoise);
+}
+.exp-modal {
+  padding: 1.5rem;
+  color: #dce3d9;
+  background: #172624;
+  border: 1px solid var(--persian-gold);
+}
+.exp-modal h4, .exp-modal h5 { color: var(--persian-gold-light); }
+.exp-modal .exp-meta { color: #aab7ad; }
+.exp-modal ul { padding-left: 1.2rem; }
+
+/* Skills: stone tablets with turquoise/gold details */
+#skills { background: var(--persian-night); }
+#skills .title-a { color: #f0e8d6; }
+#skills .subtitle-a { color: #aab7ad; }
+#skills .line-mf { background: var(--persian-gold); }
+.skill-groups {
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
+  gap: 22px;
+  margin: 2.5rem 0 1rem;
+}
+.skill-group {
+  position: relative;
+  padding: 1.6rem 1.5rem;
+  background: linear-gradient(145deg, #203331, #172624);
+  border: 1px solid rgba(198,161,91,.35);
+  border-left: 3px solid var(--persian-gold);
+  border-radius: 2px;
+  box-shadow: 0 12px 30px rgba(0,0,0,.18);
+}
+.skill-group:after {
+  content: "✦";
+  position: absolute;
+  top: 12px;
+  right: 16px;
+  color: rgba(228,201,133,.45);
+}
+.skill-group h5 { color: var(--persian-gold-light); font-size: 1.08rem; }
+.skill-tags span {
+  color: #e5e9df;
+  background: rgba(57,127,120,.25);
+  border: 1px solid rgba(104,171,158,.24);
+  border-radius: 2px;
+  padding: 6px 10px;
+}
+
+/* Blog cards and contact */
+#blog { background: var(--persian-paper); }
+.card-blog {
+  height: 100%;
+  overflow: hidden;
+  background: #fffdf7;
+  border: 1px solid #e2d7c2;
+  border-radius: 3px;
+  box-shadow: 0 10px 28px rgba(32,43,35,.07);
+  transition: transform .25s ease, box-shadow .25s ease;
+}
+.card-blog:hover { transform: translateY(-5px); box-shadow: 0 16px 36px rgba(32,43,35,.13); }
+.card-blog .card-body { padding: 1.5rem; }
+.card-blog .card-title a { color: var(--persian-ink); }
+.card-blog .card-category-box { background: var(--persian-turquoise); }
+.card-blog .card-category { color: #fff; }
+#contact { background: var(--persian-ink); }
+#contact .box-shadow-full {
+  background: #fffdf7;
+  border-top-color: var(--persian-turquoise);
+}
+#contact .title-left { color: var(--persian-ink); }
+#contact .list-ico span { color: var(--persian-gold); }
+#contact .socials .ico-circle {
+  color: var(--persian-turquoise);
+  box-shadow: 0 0 0 2px var(--persian-gold);
+}
+#contact .socials .ico-circle:hover {
+  color: #fff;
+  background: var(--persian-turquoise);
+  box-shadow: 0 0 0 3px #d8c18e;
+}
+
+/* Statistics strip */
+.section-counter {
+  background-color: var(--persian-ink);
+  background-blend-mode: multiply;
+  padding: 5rem 0;
+}
+.overlay-mf { background: #102321; opacity: .84; }
+.counter-box { color: #f1eadb; }
+.counter-ico .ico-circle {
+  color: var(--persian-gold-light);
+  box-shadow: 0 0 0 2px var(--persian-gold);
+}
+.counter-num .counter { color: #fff4dc; font-family: Georgia, serif; font-size: 2.4rem; }
+.counter-text { color: #c5c9bd; }
+
+/* Footer and floating controls */
+footer {
+  padding: 2rem 0;
+  color: #d5d8cc;
+  background: #0b1514;
+  border-top: 2px solid var(--persian-gold);
+}
+footer a { color: var(--persian-gold-light); }
+.back-to-top, .scrolltop-mf span {
+  color: #172522;
+  background: var(--persian-gold-light);
+  border-radius: 2px;
+}
+.back-to-top i { color: #172522; }
+
+/* Responsive refinement */
+@media (max-width: 767px) {
+  #mainNav { padding: 10px 0; }
+  #mainNav .navbar-collapse {
+    margin-top: 10px;
+    padding: 12px 16px;
+    background: rgba(15,27,26,.98);
+    border: 1px solid var(--persian-line);
+  }
+  #mainNav .nav-link { padding: .45rem .2rem; }
+  .intro { min-height: 650px; height: 88vh; background-position: 58% center; }
+  .intro:before { inset: 13px; }
+  .overlay-itro {
+    background: linear-gradient(90deg, rgba(9,20,19,.91), rgba(9,20,19,.54)),
+                linear-gradient(0deg, rgba(9,20,19,.5), transparent);
+  }
+  .intro-content .container { padding-left: 8%; padding-right: 8%; }
+  .intro-content .container:after { font-size: clamp(2rem, 9vw, 3.4rem); }
+  section { padding-top: 68px !important; padding-bottom: 58px !important; }
+  .title-box { margin-bottom: 2.2rem; }
+  .box-shadow-full { padding: 1.5rem 1.15rem; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *:before, *:after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
+}
