--- a/css/persepolis.css
+++ b/css/persepolis.css
@@ -788,3 +788,32 @@
  *,*:before,*:after { scroll-behavior:auto!important; animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; }
  [data-reveal] { opacity:1; transform:none; }
 }
+
+/* Center the Home statistics row */
+.hero-metrics {
+  width: 100%;
+  max-width: 650px;
+  margin-left: auto;
+  margin-right: auto;
+  justify-content: center;
+}
+.hero-metrics div {
+  flex: 1 1 0;
+  align-items: center;
+  text-align: center;
+}
+.hero-metrics div:first-child {
+  padding-left: 28px;
+}
+@media (max-width: 767px) {
+  .hero-metrics {
+    width: 100%;
+    margin-left: auto;
+    margin-right: auto;
+  }
+  .hero-metrics div {
+    flex: 1 1 0;
+    padding-left: 10px;
+    padding-right: 10px;
+  }
+}
